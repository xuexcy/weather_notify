appname               = weathernotify
version               = 0.1.1
display_name          = 天气提醒
desc                  = 定时把天气预报和气象预警推送到企业微信等 Webhook：接入和风天气官方预警（Ed25519 JWT 自动签发），无密钥时回退 Open-Meteo；支持多通道并存、正式/测试角色分流、消息样式自定义。<br />设置页可视化管理全部选项，内置定时调度与预警轮询，不需要额外配置 cron 或其他定时器。<br /><a href="https://github.com/xuexcy/weather_notify" target="_blank">项目主页</a>
changelog             = 0.1.1：改为在安装脚本内做端口自检（manifest 的 checkport 关闭），覆盖安装和升级不必再手动停应用，只在端口被其他程序占用时才提示。
platform              = x86
os_min_version        = 1.0.0
source                = thirdparty
maintainer            = xuexcy
maintainer_url        = https://github.com/xuexcy/weather_notify
distributor           = xuexcy
distributor_url       = https://github.com/xuexcy/weather_notify
service_port          = 18770
checkport             = false
ctl_stop              = true
desktop_uidir         = ui
desktop_applaunchname = weathernotify.main
